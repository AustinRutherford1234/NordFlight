+type LiveBuffer = Arc<Mutex<Option<Buffer>>>;
+#[derive(Asset, TypePath, Debug, Clone)]
+pub struct Extension {
+    bindings: Bindings,
+    live: LiveBuffer,
+    streamed: bool,
+}
+static PREPARATIONS: AtomicU64 = AtomicU64::new(0);
+static UPLOADS: AtomicU64 = AtomicU64::new(0);
+fn streamed() -> bool {
+    std::env::var_os("NORD_OCEAN_ASSET_UNIFORMS").is_none()
+}
+impl AsBindGroup for Extension {
+    type Data = <Bindings as AsBindGroup>::Data;
+    type Param = <Bindings as AsBindGroup>::Param;
+    fn label() -> &'static str {
+        "ocean parameters"
+    }
+    fn bind_group_data(&self) -> Self::Data {
+        self.bindings.bind_group_data()
+    }
+    fn bind_group_layout_entries(
+        device: &RenderDevice,
+        force_no_bindless: bool,
+    ) -> Vec<BindGroupLayoutEntry> {
+        Bindings::bind_group_layout_entries(device, force_no_bindless)
+    }
+    fn unprepared_bind_group(
+        &self,
+        layout: &BindGroupLayout,
+        device: &RenderDevice,
+        param: &mut SystemParamItem<'_, '_, Self::Param>,
+        force_no_bindless: bool,
+    ) -> Result<UnpreparedBindGroup, AsBindGroupError> {
+        let mut group =
+            self.bindings
+                .unprepared_bind_group(layout, device, param, force_no_bindless)?;
+        if self.streamed {
+            // Derived uniforms use UNIFORM only. The persistent binding must
+            // explicitly allow COPY_DST for queue writes during render prepare.
+            let mut encoded = encase::UniformBuffer::new(Vec::new());
+            encoded
+                .write(&self.bindings.parameters)
+                .expect("ocean parameter layout");
+            let buffer = device.create_buffer_with_data(&BufferInitDescriptor {
+                label: Some("streamed ocean uniform"),
+                contents: encoded.as_ref(),
+                usage: BufferUsages::UNIFORM | BufferUsages::COPY_DST,
+            });
+            let binding = group
+                .bindings
+                .iter_mut()
+                .find(|(index, _)| *index == 100)
+                .expect("ocean uniform buffer binding");
+            binding.1 = OwnedBindingResource::Buffer(buffer.clone());
+            *self.live.lock().expect("ocean buffer lock") = Some(buffer);
+        }
+        PREPARATIONS.fetch_add(1, Ordering::Relaxed);
+        Ok(group)
+    }
+}
+#[derive(Resource, Clone, ExtractResource)]
+pub(crate) struct UniformSnapshot {
+    parameters: Parameters,
+    live: LiveBuffer,
+    streamed: bool,
+    active: bool,
+}
+impl Default for UniformSnapshot {
+    fn default() -> Self {
+        Self {
+            parameters: parameters(DVec3::Y * RADIUS, 0., false),
+            live: Arc::new(Mutex::new(None)),
+            streamed: streamed(),
+            active: false,
+        }
+    }
+}
+// The buffer is written in render preparation, after material assets are ready,
+// using the snapshot extracted for this frame. Never write from the main world
+// into a buffer that a pipelined previous frame may still be preparing.
+fn upload(
+    snapshot: Option<Res<UniformSnapshot>>,
+    queue: Res<RenderQueue>,
+    mut bytes: Local<Vec<u8>>,
+    mut previous: Local<Option<(BufferId, Parameters)>>,
+) {
+    let Some(snapshot) = snapshot else {
+        return;
+    };
+    if !snapshot.streamed || !snapshot.active {
+        return;
+    }
+    let Some(buffer) = snapshot.live.lock().expect("ocean buffer lock").clone() else {
+        return;
+    };
+    if previous
+        .as_ref()
+        .is_some_and(|(id, parameters)| *id == buffer.id() && *parameters == snapshot.parameters)
+    {
+        return;
+    }
+    let mut staging = encase::UniformBuffer::new(std::mem::take(&mut *bytes));
+    staging
+        .write(&snapshot.parameters)
+        .expect("ocean parameter layout");
+    queue.write_buffer(&buffer, 0, staging.as_ref());
+    *bytes = staging.into_inner();
+    *previous = Some((buffer.id(), snapshot.parameters));
+    UPLOADS.fetch_add(1, Ordering::Relaxed);
+}
+pub fn diagnostics() -> serde_json::Value {
+    serde_json::json!({"streamed":streamed(),"whole_run_extension_preparations":PREPARATIONS.load(Ordering::Relaxed),"whole_run_buffer_writes":UPLOADS.load(Ordering::Relaxed)})
+}
