+    fn update_app(streaming: bool) -> (App, Handle<OceanMaterial>) {
+        let mut app = App::new();
+        app.add_plugins(MinimalPlugins);
+        let mut snapshot = UniformSnapshot::default();
+        snapshot.streamed = streaming;
+        let mut assets = Assets::<OceanMaterial>::default();
+        let handle = assets.add(OceanMaterial {
+            base: StandardMaterial::default(),
+            extension: Extension {
+                bindings: Bindings {
+                    parameters: snapshot.parameters,
+                    detail: Handle::default(),
+                },
+                live: snapshot.live.clone(),
+                streamed: streaming,
+            },
+        });
+        app.insert_resource(crate::carrier::scenario(true))
+            .insert_resource(crate::ViewState::default())
+            .insert_resource(snapshot)
+            .insert_resource(assets)
+            .add_systems(Update, update);
+        app.world_mut().spawn((
+            Ocean,
+            Transform::default(),
+            Visibility::Visible,
+            MeshMaterial3d(handle.clone()),
+        ));
+        app.world_mut()
+            .spawn((crate::FlightCamera, Transform::default()));
+        (app, handle)
+    }
+    #[test]
+    fn animation_updates_snapshot_without_mutating_streamed_material() {
+        for streaming in [false, true] {
+            let (mut app, handle) = update_app(streaming);
+            app.update();
+            let original = app
+                .world()
+                .resource::<Assets<OceanMaterial>>()
+                .get(&handle)
+                .unwrap()
+                .extension
+                .bindings
+                .parameters;
+            app.world_mut().resource_mut::<Flight>().elapsed = 3.5;
+            app.update();
+            let current = app.world().resource::<UniformSnapshot>();
+            assert_ne!(original, current.parameters);
+            let material = app
+                .world()
+                .resource::<Assets<OceanMaterial>>()
+                .get(&handle)
+                .unwrap();
+            if streaming {
+                assert_eq!(original, material.extension.bindings.parameters);
+            } else {
+                assert_eq!(current.parameters, material.extension.bindings.parameters);
+            }
+        }
+    }
+    #[test]
+    fn paused_snapshot_is_unchanged_and_reset_and_map_are_current() {
+        let (mut app, _) = update_app(true);
+        app.update();
+        let tick = app
+            .world()
+            .get_resource_ref::<UniformSnapshot>()
+            .unwrap()
+            .last_changed();
+        app.update();
+        assert_eq!(
+            tick,
+            app.world()
+                .get_resource_ref::<UniformSnapshot>()
+                .unwrap()
+                .last_changed()
+        );
+        app.world_mut().resource_mut::<Flight>().elapsed = 10.;
+        app.update();
+        let advanced = app.world().resource::<UniformSnapshot>().parameters;
+        *app.world_mut().resource_mut::<Flight>() = crate::physics::Flight::runway();
+        app.update();
+        assert_ne!(
+            advanced,
+            app.world().resource::<UniformSnapshot>().parameters
+        );
+        app.world_mut().resource_mut::<crate::ViewState>().map = true;
+        app.update();
+        assert!(!app.world().resource::<UniformSnapshot>().active);
+    }
